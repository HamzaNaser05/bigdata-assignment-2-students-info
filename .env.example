# MongoDB Connection Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=hamza
MONGO_PASSWORD=hamza
MONGO_AUTH_SOURCE=admin
MONGO_URI=mongodb://hamza:hamza@localhost:27017/?authSource=admin

# Database and Collection Names
MONGO_DATABASE=university
MONGO_COLLECTION_STUDENTS=students
MONGO_COLLECTION_STATS=course_stats

# Apache Spark Configuration
SPARK_MASTER=local[*]
SPARK_APP_NAME=Student Record Analysis

# Data File Paths
CSV_INPUT_PATH=hw2-data.csv
JSON_EXPORT_PATH=students.json
